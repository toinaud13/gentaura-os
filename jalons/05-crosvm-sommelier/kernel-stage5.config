# ============================================================================
# GentAura - Fragment noyau dedie au Jalon 5 (Phase 2 : Hyperviseur graphique)
# A fusionner avec kernel/gentaura.config (Jalon 1) via merge_config.sh.
# Contrat TDD Partie 2 Section 2 --- HYPERVISEUR & TUNNELS CROSVM (PHASE 2) ---
# ============================================================================
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_VHOST_VSOCK=m
CONFIG_VIRTIO_GPU=m
CONFIG_VIRTIO_GPU_LEGACY=y
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_RNG=m
CONFIG_VIRTIO_FS=m
CONFIG_FUSE_FS=m
CONFIG_OVERLAY_FS=m
# --- Zero-copy DMABUF (rappel critique, doit deja etre y depuis le J1) ---
CONFIG_UDMABUF=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y
CONFIG_DRM_VIRTIO_GPU=m
# --- Resilience cgroups v2 pour les scopes app-gentaura-vm-* ---
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_PSI=y
