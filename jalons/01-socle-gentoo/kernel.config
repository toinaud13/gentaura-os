# ============================================================================
# GentAura - Contrat noyau (TDD Partie 2, Section 2)
# Fragment de configuration a fusionner avec defconfig via
#   scripts/kconfig/merge_config.sh -m .config kernel/gentaura.config
# ou a charger directement comme config_bundle de sys-kernel/gentoo-sources.
# Supporte SIMULTANEMENT Ozone-DRM bare-metal ET crosvm Zero-Copy.
# ============================================================================

# --- SOUS-SYSTEME GRAPHIQUE (OZONE-DRM & EXO) ---
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=n
CONFIG_UDMABUF=y                  # CRITIQUE : Partage memoire zero-copie Hote <-> Exo
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y                # Synchronisation explicite Vulkan/Wayland (Explicit Sync)
# CONFIG_FB_DEVICE is not set     # On desactive le vieux framebuffer herite

# Pilotes GPU usuels (adapter selon le materiel cible)
CONFIG_DRM_I915=y
CONFIG_DRM_XE=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_VIRTIO_GPU=y           # Utile aussi sur l'hote pour les bancs d'essai KVM

# --- HYPERVISEUR & TUNNELS CROSVM (PHASE 2) ---
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=m                # (ou CONFIG_KVM_AMD=m)
CONFIG_KVM_AMD=m
CONFIG_VHOST=y
CONFIG_VHOST_VSOCK=m              # Canal de communication ultra-rapide Hote <-> VM
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_GPU=m               # Support invite Rutabaga Cross-Domain
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_FS=y
CONFIG_OVERLAYFS_FS=y
CONFIG_SQUASHFS=y                 # Image racine invitee minimale (Jalon 5)

# --- ISOLATION & RESILIENCE (SYSTEMD & SANDBOX CHROMIUM) ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_MEMCG=y                    # Cgroups v2 : arbitrage RAM Ash / crosvm
CONFIG_MEMCG_SWAP=y
CONFIG_PSI=y                      # Pressure Stall Information
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y                  # Indispensable pour le sandbox de Chromium
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- ENTREE/SORTIE (Ash pilote clavier/souris via libinput evdev) ---
CONFIG_INPUT_EVDEV=y
CONFIG_HIDRAW=y

# --- RESEAU (NetworkManager / iwd) ---
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_INET=y
CONFIG_NF_TABLES=y                # Derriere NetworkManager si besoin

# --- SON (PipeWire via ALSA/ASoC) ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_HDA_INTEL=y
